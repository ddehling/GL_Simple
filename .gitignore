# Per-project deployments (cloned from private project repos by bin/setup.*).
# Each project repo (e.g. GL_Simple_fan, GL_Simple_wol) lives at
# projects/<id>/ as a standalone clone, not as a submodule. Engine code
# stays project-agnostic. Add a line here when a new project gets a
# private repo + catalog entry.
projects/fan/
projects/weight_of_light/

# Per-machine active project selection - written by bin/setup.*, read by
# Stories_OGL.py. Kept out of git so different operators can run different
# projects on their machines without ping-ponging config.yaml.
active_project.yaml

# Python Virtual Environments
venv/
env/
ENV/
virtualenv/
.venv/
.virtualenv/

# Python compiled files
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.so
*.egg
*.egg-info/
dist/
build/
*.whl
*.nbi
*.nbc
# Python cache
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# Jupyter Notebook
.ipynb_checkpoints/

# AI tools
.claude/

# IDEs and Editors
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# OS-specific
Thumbs.db
.DS_Store
.AppleDouble
.LSOverride
desktop.ini

# Project-specific temporary files
*.log
*.tmp
*.temp

# Audio/Media cache or generated files
media/cache/
*.wav.temp
*.mp3.temp

# User-specific settings
sound_editor_settings.ini
*.local.py
*.local.ini
config.local.*

# DMX/LED output logs
dmx_output.log
led_state.log

# Shader compilation cache
*.spv
shader_cache/

# Performance profiling
*.prof
*.pstats

# Coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# Documentation builds
docs/_build/
site/

# Backup files
*.backup
*.bak
*.old
*~

# Windows installer files
*.exe
*.msi

# Environment variables
.env
.env.local
.env.*.local

# Database files
*.db
*.sqlite
*.sqlite3

# Project-specific
glsign/*
# Claude Code per-machine settings (permissions allowlist etc.)
.claude/settings.local.json
logs/
# Contact sheets written by the tools/tests/_*_visual_harness.py gates
_wyne_frames/
_storm_frames/

# Generative-music SoundFont assets (large binaries, fetched per machine)
media/soundfonts/*.sf2
media/soundfonts/*.SF2

# Generated one-shot starter set (tools/gen/oneshots.py bootstrap)
media/oneshots/*.wav

# Hosted VST3 binaries live per machine (tools/gen/plugins.py scan); the manifest is committed
media/plugins/*.vst3/
media/plugins/*.dll
media/plugins/*.txt
