{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Quick Run",
      "type": "shell",
      "group": { "kind": "build", "isDefault": true },
      "linux": {
        "command": "./bin/linux-run.sh"
      },
      "windows": {
        "command": "powershell -ExecutionPolicy Bypass -File bin\\windows-run.ps1"
      }
    },
    {
      "label": "Setup & Run",
      "type": "shell",
      "linux": {
        "command": "./bin/linux-install.sh"
      },
      "windows": {
        "command": "powershell -ExecutionPolicy Bypass -File bin\\windows-install.ps1"
      }
    }
  ]
}
