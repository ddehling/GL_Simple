[Unit]
Description=GL_Simple OpenGL Lighting Controller
After=network-online.target sound.target pipewire.service pipewire-pulse.service wireplumber.service
Wants=network-online.target pipewire.service pipewire-pulse.service wireplumber.service
# Auto-stop when the user logs into a graphical session (frees ports/DMX/audio for dev work).
Conflicts=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/home/led/Desktop/devel/GL_Simple
# Unbuffered Python so FPS/status prints hit the journal in real time.
Environment=PYTHONUNBUFFERED=1
# Wait for the PipeWire graph to assign a real (non-null) default sink.
ExecStartPre=/home/led/Desktop/devel/GL_Simple/bin/wait_for_audio.sh
ExecStartPre=/bin/sleep 2
# bin/run.sh pulls latest engine + projects (offline-tolerant), then
# execs the venv Python on Stories_OGL.py. Running it via /bin/bash
# rather than calling it directly is more robust to filesystem-permission
# quirks on /home/led/Desktop (FAT-style mounts strip the +x bit).
ExecStart=/bin/bash /home/led/Desktop/devel/GL_Simple/bin/run.sh
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
